# Скопируйте в .env и поправьте под себя.

ENVIRONMENT=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# --- авторизация (гостевая заглушка) ---
JWT_SECRET=dev-only-secret-please-change-in-production
# Гостевой токен — он же ключ от аккаунта: протухнет, и баланс не вернуть.
GUEST_TOKEN_TTL_SECONDS=2592000

# --- хранилища ---
POSTGRES_DSN=postgresql+asyncpg://poker:poker@localhost:5432/poker
REDIS_URL=redis://localhost:6379/0
ENABLE_POSTGRES=true
ALLOW_REDIS_FALLBACK=true

# --- колоды ---
# Файл заранее замешанных колод. Перегенерация: python scripts/generate_decks.py --count 100
DECK_CURSOR_KEY=poker:deck:cursor
BURN_CARDS=true

# --- стол ---
MAX_SEATS=6
ACTION_TIMEOUT_SECONDS=20
DISCONNECT_GRACE_SECONDS=10
INTER_HAND_DELAY_SECONDS=4
AUTO_FOLD_LIMIT=3
RECONNECT_WINDOW_SECONDS=120
EMPTY_TABLE_TTL_SECONDS=60

# --- прочее ---
GUEST_START_BALANCE=10000
PERSIST_HAND_HISTORY=false
